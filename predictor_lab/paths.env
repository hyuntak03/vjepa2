# predictor_lab 경로 — **이 파일 하나만** 자기 환경에 맞게 고친다 (vll7 기준으로 적었다, 2026-10-31).
# train.sh · eval.sh · table.py 가 모두 이것을 읽는다. 레지스트리 (configs/… · cvpr/registry/…) 는 건드리지 않고 실행할 때 덮어쓴다.
# 형식: export KEY=VALUE 한 줄에 하나, 값 안 참조는 $KEY 꼴만 (table.py 가 이 파일을 직접 읽는다).
#
# vll7 = 6 × RTX PRO 6000 Blackwell (sm_120) · 128 CPU. 기본 env vjepa2 (torch cu126) 는 이 GPU 커널이 없어 vjepa2_bw 를 쓴다.
# ⚠️ vll7 에는 /data2 가 없고 / (= /local_datasets) 여유가 ~40 GB 다 (2026-10-31: 3.5T 중 99 %). 그래서 학습셋은 NFS 에서 읽는다.

export LAB_REPO=/data/hyuntak/project/2026/2027_cvpr/vjepa2
export LAB_PY=/data/hyuntak/anaconda3/envs/vjepa2_bw/bin/python   # vll5 · vll6 등 (sm_90 이하) 에서는 envs/vjepa2/bin/python
export LAB_NODE=vll7                                               # sbatch -w (평가 데이터가 이 노드 로컬 디스크에 있다)
export LAB_PARTITION=batch_vll
export LAB_CVPR_DATA2=/local_datasets/world/_cvpr_data2_vll7        # 레지스트리의 ${CVPR_DATA2}/local_datasets/world/Benchmark/… 를 vll7 실물로 잇는 심볼릭 트리 (z_vll7_training/eval.sh 와 같음)

# ---- 학습 데이터: BlenderTrack v0 (NFS) --------------------------------------------------------------
export BT_CLIPS=/data/hyuntak/project/2026/2027_cvpr/nfs_cache/blender_track/v0/clips      # clip 폴더 (rgb/*.png · labels.npz · spec.json)
export BT_TRAIN_META=$LAB_REPO/data_csv/blender_track_v0/train_meta.npz                     # 4,000 clip (seed 0)
export BT_VAL_META=$LAB_REPO/data_csv/blender_track_v0/val_meta.npz                         # 400 clip (seed 1)

# ---- 평가 데이터 (vll7 로컬) ---------------------------------------------------------
# VOBench_v1 split v2 test 중 late (문맥 끝 가림) 216 쌍 = primitive 108 · realistic 108                → 시트 "VOBench P / R"
export VOB_INDEX=$LAB_REPO/data_csv/vobench_v1_split_v2/index_test.csv
export VOB_FRAMES=/local_datasets/world/testbed/VOBench_v1
# VOBench gravity test 108 block (primitive 54 · realistic 54), 고른 미래 (surprise 최소) = 진짜          → 시트 "VOBench Gravity P / R"
export GRAV_INDEX_DIR=$LAB_REPO/data_csv/vobench_v1_gravity_split                            # index_test.csv
export GRAV_FRAMES=/local_datasets/world/testbed/VOBench_v1/gravity
# IntPhys 1 dev (Garrido A.8: 창 16 · 32 × skip 2 · 5 · 10, Filtered, 180 쌍)                              → 시트 "IntPhys 1"
export IP1_INDEX_DIR=/local_datasets/world/world_analysis/IntPhys1_dev_videos                # index.csv
export IP1_FRAMES=/local_datasets/world/world_analysis/IntPhys1_dev_frame_png
# IntPhys 1 균일 창 (문맥 16 = [0, d−1] · 미래 16 = [d, 끝]) 중 가림 쌍 90 개                              → 시트 "IntPhys1 late occ"
export IP1L_INDEX_DIR=$LAB_REPO/data_csv/intphys1_late_uni                                  # index.csv (180 쌍)
export IP1L_FRAMES=/local_datasets/world/IntPhys1_late_uni                                   # 없으면 eval 이 dev PNG 링크로 만든다 (setup_intphys1_late.py)
export IP1L_OCC_LIST=$LAB_REPO/data_csv/intphys1_late/index.csv                              # 가림 쌍 90 개의 video_id 목록
# Rubric Office 실제 영상 (TCOW, 20 영상 × 2 짝 = 40 쌍, violation 앞뒤 균일 16 + 16 장)                   → 시트 "rubric office"
export RUB_SRC=/local_datasets/world/testbed/real_bench/rubric_office_quads                 # 원본 (<scene>/<video>/<variant>.mp4)
export RUB_INDEX=$LAB_REPO/data_csv/rubric_quads_uniform/index_mp4.csv                       # 쌍 · 변이 + 영상마다 읽을 프레임 번호 32 개 (make_rubric_index.py) — mp4 에서 바로 읽는다

# ---- 기준 predictor ------------------------------------------------------------------------------
export RELEASE_PRED=$LAB_REPO/z_training/runs/release_vith/latest.pt                         # 릴리즈 V-JEPA 2 ViT-H predictor (predictor 만)
# encoder (ViT-H) 체크포인트는 configs/protocols/models.md 의 `vith` 항목이 정본이다.
