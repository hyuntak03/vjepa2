# =============================================================================
# 기계별 절대경로의 **정본**. 레포에서 절대경로를 하드코딩하는 곳은 여기 하나다.
#
#   bash   :  source z_research/scripts/harness/env.sh   (이 파일을 source 하고 파생값까지 export)
#   python :  z_research/scripts/harness/paths.py 가 읽어 os.environ 에 채운다
#   md/yaml:  레지스트리·프로토콜 값 안의 `${VAR}` 를 resolve.py 가 푼다
#
# 문법은 `KEY=${KEY:-기본값}` 으로 통일한다 — bash 가 그대로 source 할 수 있고
# (이미 환경에 있는 값이 이긴다), paths.py 의 파서도 같은 규칙으로 읽는다.
# ⚠️ 값에 공백을 넣지 말 것. 따옴표 없이 한 줄 한 키다.
#
# 기계를 옮기면 **이 파일만** 고친다. VJEPA2_ROOT / CKPT_ROOT / DATA_CSV 는
# 레포 위치에서 파생되므로 여기 없다 (env.sh · paths.py 가 __file__ 로 잡는다).
# =============================================================================

# --- 파이썬 ------------------------------------------------------------------
VJEPA2_PY=${VJEPA2_PY:-/nas2/data/takhyun03/anaconda3/envs/vjepa2/bin/python}
CONDA_ACTIVATE=${CONDA_ACTIVATE:-/nas2/data/takhyun03/anaconda3/bin/activate}
CONDA_ENV=${CONDA_ENV:-vjepa2}

# --- 데이터 ------------------------------------------------------------------
# WORLD_ROOT 아래가 이 프로젝트의 데이터 전부다. **로컬 디스크여야 한다** (/data2 = xfs).
#   benchmarks/        외부 벤치마크 (IntPhys1 · IntPhys2 · InfLevel · GRASP)
#   training_datasets/ predictor 학습 데이터
#   cache/             토큰 캐시 (세트당 30~400GB. NFS 에 두면 시간을 버린다)
WORLD_ROOT=${WORLD_ROOT:-/data2/local_datasets/world}
BENCH_ROOT=${BENCH_ROOT:-${WORLD_ROOT}/benchmarks}
TRAIN_DATA_ROOT=${TRAIN_DATA_ROOT:-${WORLD_ROOT}/training_datasets}
WMA_CACHE_DIR=${WMA_CACHE_DIR:-${WORLD_ROOT}/cache}

# 벤치마크 **공식 코드/보조 파일** (영상이 아니라 레포). InfLevel 쌍 목록이 여기 있다:
#   ${BENCH_CODE_ROOT}/jepa-intuitive-physics/evaluation_code/auxiliary_data_loading_files/inflevel/*.csv
#   ${BENCH_CODE_ROOT}/{grasp,inflevel,IntPhys2}/   공식 레포 (참조용)
BENCH_CODE_ROOT=${BENCH_CODE_ROOT:-/nas2/data/takhyun03/project/2026/world_model/benchmarks}

# --- SLURM -------------------------------------------------------------------
# ⚠️ WORLD_ROOT 가 /data2 = **노드 로컬 디스크**라 다른 노드에서는 안 보인다.
#    그래서 job 은 WM_SLURM_NODE 에 고정한다. 데이터를 옮기면 여기도 같이 바꾼다.
WM_SLURM_PARTITION=${WM_SLURM_PARTITION:-batch_ugrad}
WM_SLURM_NODE=${WM_SLURM_NODE:-ariel-k2}
WM_SLURM_GPUS=${WM_SLURM_GPUS:-8}
