# =============================================================================
# 경로 정본 — 이 기계의 절대경로는 **이 파일 하나에만** 쓴다 (CLAUDE.md §9-0).
#
#   bash   : source z_research/scripts/harness/env.sh      (run.sh·train.sh·sbatch.sh 가 이미 한다)
#   python : sys.path 에 harness 를 넣고 `from paths import ROOT, expand, BENCH_ROOT, ...`
#   md/yaml: 값에 ${BENCH_ROOT}/IntPhys1 처럼 쓰면 resolve.py / resolve_train.py 가 푼다
#   확인   : python z_research/scripts/harness/paths.py    (표 + 실재 여부)
#
# 형식 규칙 (bash `source` 와 paths.py 가 **같은 파일을 같은 뜻으로** 읽게):
#   KEY=VALUE 한 줄에 하나. 값 안의 참조는 ${KEY} 꼴만 (위에서 정의된 키 또는 VJEPA2_ROOT).
#   명령 치환 $(...)·백틱·줄 이어쓰기 금지. 따옴표는 써도 되고 벗겨서 읽는다.
#
# VJEPA2_ROOT 는 여기 없다 — env.sh / paths.py 가 **이 파일의 위치에서** 파생한다
# (레포를 옮겨도 이 파일은 안 고친다). 기계를 옮기면 아래 값만 고친다.
#
# 기계: Vast.ai 컨테이너 (8x RTX PRO 6000 Blackwell 96G, driver 580 / CUDA 13.0 max), 2026-09-29 재이전
#   (그 전 Vast 기계: 8x RTX PRO 5000 Blackwell 48G, 2026-09-28 — 벤치마크 폴더가 benchmark 단수였다)
#   / 가 5.3T overlay 하나다 (NFS·노드 로컬 구분 없음). /workspace 는 **볼륨이 아니다** —
#   recycle/destroy 하면 전부 사라진다. 지울 수 없는 산출물은 기계 밖으로 옮길 것.
# 옛 기계 값 (기록): ariel-k2 — VJEPA2_PY=/nas2/data/takhyun03/anaconda3/envs/vjepa2/bin/python,
#   WORLD_ROOT=/data2/local_datasets/world, WM_SLURM_PARTITION=batch_ugrad, WM_SLURM_NODE=ariel-k2
# =============================================================================

# 파이썬 — conda env `vjepa` (/venv/vjepa, python 3.12 · torch 2.12.1+cu129, 2026-09-29).
#   Blackwell sm_120 은 cu128 이상이 필요하다. 이미지 기본 env `/venv/main` 은 쓰지 않는다.
#   재설치: conda create -n vjepa python=3.12 pip -y
#          uv pip install --python /venv/vjepa/bin/python torch==2.12.1 torchvision==0.27.1 --index-url https://download.pytorch.org/whl/cu129
#          uv pip install --python /venv/vjepa/bin/python -r requirements.txt matplotlib pytest
VJEPA2_PY=/venv/vjepa/bin/python
# tmux_train.sh · sbatch.sh 가 `source "$CONDA_ACTIVATE" "$CONDA_ENV"` 로 부른다
CONDA_ACTIVATE=/opt/miniforge3/bin/activate
CONDA_ENV=vjepa

# 데이터 전부 (벤치마크 · 학습셋 · 토큰 캐시)
WORLD_ROOT=/workspace/world_model/local_datasets/world
# 벤치마크 원본 (2026-09-29): /workspace/dataset/benchmarks/{IntPhys1,IntPhys2,InfLevel,GRASP,EK100}  (복수형)
BENCH_ROOT=/workspace/dataset/benchmarks
# 학습 영상 (2026-09-29): SSv2/20bn-something-something-v2/*.webm · K400/{train,val}/*.mp4  (이 기계는 SSv2 대문자)
TRAIN_DATA_ROOT=/workspace/dataset/training_data
WMA_CACHE_DIR=${WORLD_ROOT}/cache

# 벤치마크 **공식 레포** (jepa-intuitive-physics · grasp · inflevel · IntPhys2)
BENCH_CODE_ROOT=${BENCH_ROOT}/repos

# 레포 안 (위치에서 파생). ⚠️ CLAUDE.md 는 checkpoints/ 라 적었지만 models.md 와 .gitignore 는
# checkpoint/ (단수) 다 — 단수를 쓴다 (복수면 .pth·HF blob 이 untracked 로 뜬다).
CKPT_ROOT=${VJEPA2_ROOT}/checkpoint
DATA_CSV=${VJEPA2_ROOT}/data_csv

# SLURM — 이 기계에는 없다 (sbatch 없음). 비워 두면 sbatch.sh 가 제출 전에 멈춘다.
# 학습은 z_training/tmux_train.sh, 채점은 run.sh 를 직접 부른다.
WM_SLURM_PARTITION=
WM_SLURM_NODE=
