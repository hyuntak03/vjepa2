# =============================================================================
# vll7 경로 정본 — 이 기계의 절대경로는 **이 파일 하나에만** 쓴다.
#
#   bash   : source z_vll7_training/env.sh        (train.sh · tmux_train.sh · sbatch.sh 가 이미 한다)
#   yaml   : 값에 ${LOCAL_K400}/... 처럼 쓰면 resolve_train.py 가 푼다 (os.path.expandvars)
#   확인   : bash z_vll7_training/env.sh --show
#
# 형식 규칙 (bash `source` 로 그대로 읽힌다): KEY=VALUE 한 줄에 하나, 값 안 참조는 ${KEY} 꼴만,
#   명령 치환 $(...) · 백틱 금지. VJEPA2_ROOT 는 여기 없다 — env.sh 가 이 파일 위치에서 파생한다.
#
# 기계: vll7 (SLURM 노드) — 6 x RTX PRO 6000 Blackwell (**sm_120**), 128 CPU, 489 GB RAM.
#   ⚠️ 기존 `vjepa2` env (torch 2.12.0+cu126) 는 sm_50..sm_90 으로만 빌드돼 **이 GPU 에서 커널이 안 올라간다.**
#      그래서 vll7 전용 env `vjepa2_bw` (torch 2.12.1+cu129, 2026-10-16 생성) 를 쓴다. 드라이버 580.126.09.
#   ⚠️ 이 노드에는 **/data2 가 없다.** / (3.5T NVMe) 가 92 % 차 있어 여유 ~300 G 뿐 — 큰 산출물을 흘리지 말 것.
#   ⚠️ 학습 영상은 **노드 로컬** 이라 다른 노드에서 이 csv 가 안 맞는다 (data_csv/ssv2/*.csv 는 /data2 경로다).
# =============================================================================

# ── 파이썬 ───────────────────────────────────────────────────────────────────
VJEPA2_PY=/data/hyuntak/anaconda3/envs/vjepa2_bw/bin/python
CONDA_ACTIVATE=/data/hyuntak/anaconda3/bin/activate
CONDA_ENV=vjepa2_bw

# ── 학습 영상 (노드 로컬 NVMe) ───────────────────────────────────────────────
LOCAL_K400=/local_datasets/Kinetics400/kinetics400_320p/train
LOCAL_SSV2=/local_datasets/something-something-v2-mp4

# ── 벤치마크 (in-loop val · 채점) ────────────────────────────────────────────
BENCH_ROOT=/local_datasets/world/world_analysis
INTPHYS1_DEV_FRAMES=${BENCH_ROOT}/IntPhys1_dev_frame_png

# ── 레포 안 ──────────────────────────────────────────────────────────────────
CKPT_ROOT=${VJEPA2_ROOT}/checkpoint
DATA_CSV=${VJEPA2_ROOT}/data_csv
VLL7_RUNS=${VJEPA2_ROOT}/z_vll7_training/runs
TRAIN_CFG_DIR=${VJEPA2_ROOT}/z_vll7_training/configs

# ── SLURM ────────────────────────────────────────────────────────────────────
WM_SLURM_PARTITION=batch_vll
WM_SLURM_NODE=vll7
WM_SLURM_GPUS=6
